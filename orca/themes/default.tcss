Screen {
    layout: vertical;
}

MillerColumns {
    height: 1fr;
    width: 100%;
}

OptionList {
    height: 100%;
    border: solid green;
}

OptionList:focus {
    border: solid #00ff00;
}

PreviewPanel {
    height: 100%;
    padding: 1 2;
    background: $panel;
}

/* Theme: Transparent (respeta tu terminal de fondo) */
Screen.theme-transparent {
    background: transparent;
}
Screen.theme-transparent MillerColumns {
    background: transparent;
}
Screen.theme-transparent OptionList {
    background: transparent;
    border: solid rgba(255,255,255,0.3);
}
Screen.theme-transparent OptionList:focus {
    border: solid rgba(0,255,0,0.7);
    background: transparent;
}
Screen.theme-transparent PreviewPanel {
    background: transparent;
    border: solid rgba(255,255,255,0.2);
}
Screen.theme-transparent ColumnDivider {
    background: transparent;
}

/* Theme: Pink (Synthwave) */
Screen.theme-pink {
    background: #2b112c;
}
Screen.theme-pink OptionList {
    background: #2b112c;
    border: solid #ff3399;
    color: #ffb6c1;
}
Screen.theme-pink OptionList:focus {
    border: solid #ff66b2;
    background: #4a154b;
}
Screen.theme-pink PreviewPanel {
    background: #3e1236;
    color: #ffb6c1;
    border: solid #ff3399;
}

/* Theme: Light Black (Carbón) */
Screen.theme-light-black {
    background: #1e1e1e;
}
Screen.theme-light-black OptionList {
    background: #1e1e1e;
    border: solid #555555;
    color: #dddddd;
}
Screen.theme-light-black OptionList:focus {
    border: solid #888888;
    background: #2d2d2d;
}
Screen.theme-light-black PreviewPanel {
    background: #252525;
    border: solid #555555;
    color: #dddddd;
}
